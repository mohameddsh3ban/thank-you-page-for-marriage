# Cloudflare Pages headers. The loading screens fetch every asset once and the page then reads
# them back from the browser cache, so they must be cacheable: hashed bundles forever, media for a day.
/*
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/art/*
  Cache-Control: public, max-age=86400

/photos/*
  Cache-Control: public, max-age=86400

/audio/*
  Cache-Control: public, max-age=86400

/private/*
  Cache-Control: public, max-age=86400

/private/site.html
  ! Cache-Control
  Cache-Control: no-cache
